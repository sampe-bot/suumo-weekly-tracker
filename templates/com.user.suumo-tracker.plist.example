<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.suumo-tracker</string>
    <key>WorkingDirectory</key>
    <string>/REPLACE/WITH/PATH/TO/suumo-weekly-tracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/REPLACE/WITH/PATH/TO/.local/bin/uv</string>
        <string>run</string>
        <string>suumo-tracker</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/REPLACE/WITH/PATH/TO/suumo-weekly-tracker/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/REPLACE/WITH/PATH/TO/suumo-weekly-tracker/stderr.log</string>
</dict>
</plist>
